                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              }
            }
          }
        },
        "example": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid request",
            "requestId": "3f1c...",
            "details": [
              {
                "field": "limit",
                "message": "must be an integer 1..100"
              }
            ]
          }
        }
